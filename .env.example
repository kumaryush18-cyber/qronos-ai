NODE_ENV=production

# Database (TiDB / MySQL)
CUSTOM_DATABASE_URL=
DATABASE_URL=mysql://user:password@gateway01.example.com:4000/test

# Security (Generate a 64-char hex key via: openssl rand -hex 32)
JWT_SECRET=
QRONOS_ADMIN_PASSCODE=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Developer Login)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub Personal Access Token
PAT_TOKEN=
GITHUB_PAT_TOKEN=

# Discord (bot + OAuth verification)
# Set these in GitHub Secrets, never here: the deploy workflow writes them into
# .env on the server, and the image never carries them.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Public Origin (Custom domain: qronos.me)
QRONOS_PUBLIC_ORIGIN=https://qronos.me

# Other API Keys
CLAUDE_OPUS5_API_KEY=
CLAUDE_OPUS5_MODEL=
CLAUDE_OPUS5_BASE_URL=
CLUSTER_PROTOCOL_API_KEY=
CLUSTER_PROTOCOL_BASE_URL=
FXQIDIAN_API_KEY=
FXQIDIAN_BASE_URL=
NVIDIA_CLAUDE_FABLE5_API_KEY=
NVIDIA_CLAUDE_FABLE5_MODEL=
NVIDIA_CLAUDE_FABLE5_BASE_URL=
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=
TOKENROUTER_MODEL=
TOKENROUTER_GLM53_MODEL=
TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=
RENDER_NIM_PROXY_API_KEY=
RENDER_NIM_PROXY_MODEL=
OPENCODE_CLAUDE_OPUS5_API_KEY=
OPENCODE_CLAUDE_OPUS5_MODEL=
OPENCODE_CLAUDE_OPUS5_BASE_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Solana Pay & Helius Integration (Mainnet-Beta)
SOLANA_MERCHANT_WALLET=
# Put your own key in the query string: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=
HELIUS_API_KEY=
SOLANA_NETWORK=mainnet-beta

# Direct UPI Rail (India Zero-Fee Domestic Settlement)
UPI_ID=
UPI_MERCHANT_NAME=
ADMIN_SECRET_KEY=

# Dodo Payments Integration (Global Cards, Apple Pay, Google Pay)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_STARTER_PRD=
DODO_PRO_PRD=
DODO_MAX_PRD=
DODO_POWER_PRD=
DODO_ULTRA_PRD=

# Whop Payments Integration (Cards, Apple Pay, Google Pay)
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_10_CREDITS_PRODUCT_ID=
WHOP_10_CREDITS_PLAN_ID=
